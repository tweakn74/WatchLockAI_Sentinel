{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/metrics/health Response",
  "description": "JSON schema for GET /api/metrics/health endpoint response",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "unhealthy",
        "degraded"
      ]
    },
    "uptime": {
      "type": "number",
      "minimum": 0
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "required": [
    "status"
  ],
  "additionalProperties": true,
  "examples": [
    {
      "status": "healthy",
      "uptime": 3600.5
    },
    {
      "status": "unhealthy",
      "checks": {
        "database": false
      }
    }
  ]
}