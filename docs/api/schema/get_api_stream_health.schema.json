{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /api/stream/health Response",
  "description": "Response schema for GET /api/stream/health",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "unhealthy",
            "degraded"
          ]
        },
        "uptime": {
          "type": "number",
          "minimum": 0
        },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "description": "Success response (HTTP 200)"
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "integer"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "description": "Error response (HTTP 429)"
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "integer"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "description": "Error response (HTTP 401)"
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "code": {
          "type": [
            "string",
            "integer"
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true,
      "description": "Error response (HTTP 500)"
    }
  ],
  "examples": [
    {
      "status": "healthy",
      "uptime": 3600.5
    },
    {
      "status": "unhealthy",
      "checks": {
        "database": false
      }
    }
  ]
}