# WatchLockAI Sentinel Configuration Template
# Copy this file to .env and modify as needed
# All features are DEFAULT OFF for non-breaking deployment

# ===================================================================
# BASIC SYSTEM CONFIGURATION
# ===================================================================

# Web API Configuration
# WEB_API_HOST=127.0.0.1
# WEB_API_PORT=8080

# Logging Configuration  
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ===================================================================
# CORE FEATURE FLAGS (P1 Suite - Legacy)
# ===================================================================

# Health endpoint (default ON)
HEALTH_ENDPOINT_ENABLED=1

# Debug metrics exposure (default OFF)
METRICS_DEBUG_ENABLED=0

# Configuration hot reload (default OFF) 
CONFIG_HOT_RELOAD_ENABLED=0
CONFIG_HOT_RELOAD_DEBOUNCE_MS=750

# MITRE ATT&CK API integration (default OFF)
MITRE_API_ENABLED=0

# ===================================================================
# SECURITY & AUTHENTICATION (P2-P3 Suite)
# ===================================================================

# Admin route RBAC protection (default OFF)
ADMIN_AUTH_ENABLED=0
ADMIN_TOKEN=""

# Console user authentication (default OFF)
CONSOLE_AUTH_ENABLED=0
CONSOLE_AUTH_SESSION_KEY=""  # Must be 64-char hex (32 bytes)
CONSOLE_AUTH_RATE_LIMIT=10

# Rate limiting (default OFF for non-regression)
RATE_LIMIT_ENABLED=0

# ===================================================================
# MONITORING & ANALYTICS (P2 Suite)
# ===================================================================

# Anomaly detection engine (default OFF)
ANOMALY_ENABLED=0
ANOMALY_SKLEARN_ENABLED=0  # Requires sklearn

# Real-time streaming (Server-Sent Events) (default OFF)
STREAM_ENABLED=0
STREAM_TYPE=sse
STREAM_HEALTH_INTERVAL_MS=1000
STREAM_REQUIRE_AUTH=0

# File quarantine system (default OFF)
QUARANTINE_ENABLED=0

# ===================================================================
# OPERATIONAL FEATURES (P3-P4 Suite)
# ===================================================================

# Log rotation and redaction (default ON for security)
LOG_MAX_BYTES=1048576  # 1MB
LOG_BACKUPS=5
LOG_REDACT_SECRETS=1

# Windows service integration (default OFF)
SERVICE_ENABLED=0

# Plugin sandbox system (default OFF)
PLUGINS_ENABLED=0

# Telemetry export (default OFF)
EXPORT_ENABLED=0

# System backup and restore (default OFF)
BACKUP_ENABLED=0
BACKUP_DIR=data/backups

# Secret rotation toolkit (default OFF)
ROTATE_ENABLED=0

# Chaos engineering probes (default OFF)
CHAOS_ENABLED=0

# Minimal web console UI (default OFF)
CONSOLE_UI_ENABLED=0

# ===================================================================
# P5 RELEASE CANDIDATE FEATURES
# ===================================================================

# Data retention and cleanup (default OFF)
RETENTION_ENABLED=0
RETENTION_DAYS=14

# Performance testing probes (default OFF)
PERF_PROBE_ENABLED=0

# ===================================================================
# ADVANCED CONFIGURATION
# ===================================================================

# Database configuration (if applicable)
# DATABASE_URL=sqlite:///data/sentinel.db
# DATABASE_POOL_SIZE=5

# External integrations
# WEBHOOK_URL=""
# SLACK_TOKEN=""
# TEAMS_WEBHOOK=""

# TLS/SSL configuration (recommended for production)
# SSL_CERT_PATH=""
# SSL_KEY_PATH=""
# SSL_ENABLED=0

# Resource limits
# MAX_MEMORY_MB=512
# MAX_CPU_PERCENT=50
# MAX_DISK_GB=10

# ===================================================================
# DEVELOPMENT & TESTING
# ===================================================================

# Development mode (enables additional debugging)
# DEV_MODE=0

# Test mode configuration
# TEST_MODE=0
# TEST_DATA_DIR=test_data

# Mock external services for testing
# MOCK_EXTERNAL_APIS=0

# ===================================================================
# NOTES
# ===================================================================
# 
# 1. All features are DEFAULT OFF to ensure non-breaking deployment
# 2. Enable features gradually based on your requirements
# 3. RBAC (Admin auth) is recommended for production environments
# 4. Use strong, randomly generated tokens for authentication
# 5. Configure SSL/TLS for production deployments
# 6. Monitor resource usage when enabling multiple features
# 7. Test configuration changes in non-production environment first
# 8. Backup your configuration before making changes
# 9. Review security implications of each enabled feature
# 10. Consult operations runbook for detailed setup instructions
#
# For detailed documentation, see:
# - DOCS/operations_runbook.md
# - DOCS/deploy_windows.md  
# - DOCS/security/threat_model.md
#
